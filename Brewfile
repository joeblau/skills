# Fast, user-friendly file finder (honors .gitignore)
brew "fd"

# Recursive code searcher (faster than grep/ack)
brew "ripgrep"

# AST-aware code search and refactor tool
brew "ast-grep"

# JSON processor for quick transforms
brew "jq"

# General-purpose fuzzy finder
brew "fzf"

# cat with syntax highlighting, paging, and git integration
brew "bat"

# Modern ls replacement with better defaults
brew "eza"

# Smarter cd that learns your paths
brew "zoxide"

# Human-friendly HTTP client
brew "httpie"

# Enhanced git diff/pager with syntax coloring
brew "git-delta"

# Video/audio encoder — required by b:sludge for compositing and captions
brew "ffmpeg"
